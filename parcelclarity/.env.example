# ParcelClarity environment variables.
# Copy to .env.local and fill in. NEVER commit real values.

# --- Public (exposed to the browser) ---
# Canonical site URL; used for auth redirects and invitation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase project URL and anon (publishable) key. The anon key is safe to
# expose ONLY because Row Level Security is enabled on every table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only ---
# Service-role key. NOT required by Milestone 1 application code. Reserved for
# narrowly scoped server jobs added later (webhooks, background jobs). Never
# expose it to the browser and never use it for user-initiated reads.
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email for invitations (https://resend.com). Optional: when unset,
# invitation links are shown to the inviting admin to share manually and the UI
# says clearly that no email was sent.
RESEND_API_KEY=
EMAIL_FROM="ParcelClarity <no-reply@example.com>"

# --- Later milestones (placeholders; see IMPLEMENTATION_STATUS.md) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
